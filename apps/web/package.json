{
  "name": "lospor-app",
  "version": "9.3.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:shared-core": "node scripts/check-shared-core-boundaries.mjs",
    "verify:boundaries": "node scripts/check-shared-core-boundaries.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "smoke": "playwright test --config playwright.smoke.config.ts",
    "e2e:db:up": "node scripts/e2e-db.mjs up",
    "e2e:db:reset": "node scripts/e2e-db.mjs reset",
    "e2e:db:down": "node scripts/e2e-db.mjs down",
    "e2e:seed": "node scripts/e2e-db.mjs seed",
    "e2e:crossapp": "npm --prefix ../lospor-mobile run export:web:e2e && playwright test --config playwright.crossapp.config.ts"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "serialize-javascript": "^7.0.6",
    "minimatch": "10.2.6"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@hookform/resolvers": "^5.2.2",
    "@lospor/core": "github:kaloyandjunow-prog/lospor-core#v9.2.0",
    "@sentry/nextjs": "^10.57.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "driver.js": "^1.4.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.12",
    "next-intl": "^4.11.2",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitalets/google-translate-api": "^9.2.1",
    "@vitest/coverage-v8": "^4.1.9",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
