{
  "name": "@lospor/hospital-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:shared-core": "node scripts/check-shared-core-boundaries.mjs",
    "verify:boundaries": "node scripts/check-shared-core-boundaries.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:crossapp": "playwright test --config playwright.crossapp.config.ts",
    "e2e:ui": "playwright test --ui",
    "e2e:seed": "npm --prefix ../api run e2e:seed",
    "typecheck": "next typegen && tsc --noEmit --pretty false",
    "test:coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary"
  },
