# Local development. In the appliance, Compose supplies the internal API
# address and Caddy publishes the configured Hospital domains.
LOSPOR_API_INTERNAL_URL="http://127.0.0.1:3002"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
MOBILE_PWA_URL="http://localhost:8081"
CORS_ALLOW_ORIGIN="http://localhost:8081"
CORS_ALLOW_ORIGINS="http://localhost:8081"

# Optional institution-managed error reporting. Empty disables it.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
