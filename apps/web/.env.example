# Internal API origin used by Next.js server rendering and the temporary
# /api compatibility proxy. Do not expose this value to browser JavaScript.
LOSPOR_API_INTERNAL_URL="https://api.lospor.org"

# Public browser origin used in links and client-side navigation.
NEXT_PUBLIC_APP_URL="https://app.lospor.org"

# Expo web PWA deployment. Mobile browsers are redirected here when set.
MOBILE_PWA_URL="https://pwa.lospor.org"

# Allowed origin for the temporary V6 /api compatibility proxy.
CORS_ALLOW_ORIGIN="https://pwa.lospor.org"
CORS_ALLOW_ORIGINS="https://pwa.lospor.org"

# Unauthenticated server-rendered and PWA-manifest locale. The installer may
# set bg or en. Missing and invalid values deliberately fall back to bg.
LOSPOR_DEFAULT_LOCALE="bg"

# Optional Sentry configuration.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
