  /// combination code such as E11.2, diabetes with a kidney complication):
  /// standardConceptId is then null and the export writes one row per id.
  /// Empty otherwise.
  standardConceptIds Int[]              @default([])
  mappingStatus     ConceptMappingStatus   @default(SOURCE_ONLY)
  source            String                 @default("sync") // sync-audit metadata, always "relational-sync" — NOT clinical provenance
  clinicalSource    String? // "manual" | "ai-scan" | "import"; who/what recorded this item. Nullable: absent means unknown for pre-existing rows.
  sourceVersion     String?
  ordinal           Int                    @default(0)
