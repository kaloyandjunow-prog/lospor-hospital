  /// a test server usually offers.
  STATIC_BEARER
  /// SMART-on-FHIR client credentials: a client id and secret exchanged for a
  /// short-lived token. What most hospital FHIR servers actually use.
  OAUTH2_CLIENT_CREDENTIALS
}

enum EhrImportTransport {
  /// A file the hospital system writes into a watched directory.
  FOLDER
  FHIR
  HL7V2
}

/// Which code list a hospital's coding-system address stands for.
enum HospitalEhrCodeList {
  /// ICD-10, including the Bulgarian МКБ-10 of NHIS list CL011.
  ICD10
  /// ICD-10-PCS: an exact operation, and its research code.
  ICD10PCS
  /// Bulgarian procedure codes (КСМП, based on ACHI).
  KSMP
  /// NHIS routes of administration from EDQM terms.
  NHIS_CL013
  /// NHIS routes of administration from HL7.
  NHIS_CL046
  /// NHIS laboratory tests.
  NHIS_CL024
  /// Answered, and none of the above: stops the address being asked about.
  OTHER
}

enum EhrImportStatus {
  /// Waiting for a clinician to review it.
  PENDING
  /// Every field was decided.
  REVIEWED
  /// Nothing was taken from it.
  DISCARDED
  /// Nobody claimed it inside the retention window.
  EXPIRED
}

enum EhrImportFieldStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// What the hospital system sent, before a clinician has agreed to any of it.
///
/// Imported values are never written into a case on arrival. Two reasons, both
/// found the hard way: the server refuses a write where age and clinical mode
/// disagree, so an unattended importer walks straight into the pediatric trap;
/// and only the web app surfaces a save conflict, so an import colliding with a
/// bedside edit would be resolved by silently discarding one of them. Staging
/// the values and having a clinician accept them field by field avoids both,
/// and is also the safer clinical answer.
model EhrImport {
  id               String                @id @default(cuid())
  institutionId    String
  institution      Institution           @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  /// Hashed the same way a PatientLink is, so an import can be found by the
  /// number a clinician types without the number itself being stored here.
  identifierType   PatientIdentifierType @default(IZ)
  /// Which year's numbering the record number was staged under.
  ///
  /// ИЗ № restarts at 1 every January, so the same digits are a different
  /// admission each year and the year is part of the identity -- exactly as on
  /// PatientLink, which has carried this since the v2 hash. It was missing
  /// here while the code that writes the row already supplied it, so Prisma
  /// would have refused the write as an unknown argument.
  ///
  /// Zero for ЕГН, which is issued once for life and belongs to no year.
  identifierYear   Int                   @default(0)
  identifierHash   String
  hashVersion      Int                   @default(2)
  maskedIdentifier String
  transport        EhrImportTransport
  /// Whatever the transport calls a message: a filename, an HL7 control id.
  sourceMessageId  String?
  /// SHA-256 of the delivered payload. Redelivering the same message must not
  /// produce a second pending import for the clinician to review twice.
  payloadHash      String
  receivedAt       DateTime              @default(now())
  /// Unclaimed imports hold clinical data for a patient who may have no case
  /// here at all, so they do not live indefinitely.
  expiresAt        DateTime
  status           EhrImportStatus       @default(PENDING)
  /// True when the patient this came from was matched on the record number
  /// alone, because nobody had yet said which of the hospital's numberings a
  /// record number belongs to.
  ///
  /// A hospital numbers the same person several ways, so one clean match can
  /// belong to a different numbering entirely -- which is what a wrong-patient
  /// import looks like from here. Once a site configures the system such a
  /// match is refused outright; until then the import proceeds and this says
  /// plainly that the identity was not checked, so a clinician reviewing an
  /// allergy list knows how much the match is worth.
  ///
  /// Stored rather than computed because review happens long after the pull,
  /// and by then the search that produced it is gone.
  identityUnverified Boolean             @default(false)
  /// Which groups the hospital system could not be read for, and why.
  ///
  /// The resource fetches are independent by design: a server that serves
  /// laboratory results but refuses allergies should still yield the labs.
  /// What that costs is silence -- an allergy list that failed to load and a
  /// patient with no known allergies arrive on the review screen identically,
  /// and the second one reads as reassurance.
  ///
  /// An array of `{ group, errorCode }`. Stored rather than reported at pull
  /// time for the same reason the unverified identity is: the clinician reads
  /// the screen long after the request that failed.
  unreadSources    Json?
  reviewedAt       DateTime?
  /// Not a foreign key, following PatientLink.createdById: removing a user must
  /// not cascade into clinical provenance.
  reviewedById     String?
  fields           EhrImportField[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([institutionId, payloadHash])
  @@index([institutionId, identifierType, identifierHash, status])
  @@index([expiresAt])
}

/// One proposed value, and what the clinician decided about it.
model EhrImportField {
  id            String               @id @default(cuid())
  importId      String
  import        EhrImport            @relation(fields: [importId], references: [id], onDelete: Cascade)
  /// The canonical section and field name the value maps onto, so review and
  /// application both speak the same language as the rest of the API.
  section       String
  fieldKey      String
  /// One row per *reviewable item*, not per field.
  ///
  /// A clinician accepts one diagnosis and refuses another from the same list,
  /// so the field is the wrong grain to decide at: storing the whole list in a
  /// single row meant refusing one item recorded a refusal against
  /// `diagnoses`, silencing every future diagnosis for that patient. This is
  /// the key Core derives, stable across the hospital recoding or relabelling
  /// the same item — a scalar field's key is just the field name.
  itemKey       String
  /// One scalar, one tag or one lab result — never a collection.
  proposedValue Json
  status        EhrImportFieldStatus @default(PENDING)
  decidedAt     DateTime?
  decidedById   String?

  @@unique([importId, itemKey])
  @@index([importId, status])
  @@index([importId, section, fieldKey])
}

enum EhrDeliveryKind {
  /// The protocol PDF and its coded header, sent together.
  PROTOCOL
  /// A difficult airway or an allergy — its own message, because it is the
  /// part that changes what happens at the patient's next admission and is
  /// wasted inside a document nobody opens until then.
  SAFETY_FINDINGS
  /// Emitted as facts. Whether the hospital system ingests them silently or
  /// raises a prompt is its business; nothing here waits on the answer.
  CASE_START
  CASE_END
}

enum EhrDeliveryStatus {
  /// Waiting for the undo window to close, or for the worker to pick it up.
  PENDING
  SENDING
  SENT
  /// A permanent refusal. Retrying would fail identically.
  FAILED
  /// A later finalization replaced this message before it was sent.
  SUPERSEDED
}

/// One message queued for the hospital system.
///
/// There is no scheduler in the appliance, so "wait until later" is a WHERE
/// predicate rather than a job: a worker polls and asks for whatever is due.
model EhrDelivery {
  id             String            @id @default(cuid())
  institutionId  String
  institution    Institution       @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  caseId         String
  case           Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// Which finalization this describes. A correction produces a new row that
  /// supersedes the previous one rather than editing it, so what was sent
  /// stays reconstructable.
  finalizationId String
  sequence       Int
  kind           EhrDeliveryKind
  status         EhrDeliveryStatus @default(PENDING)
  /// Not before this moment.
  ///
  /// A case can be unfinalized and edited for FINALIZE_UNDO_WINDOW_MS. Sending
  /// at the moment of finalization would make every ordinary tidy-up inside
  /// that window a second message to the hospital minutes after the first, and
  /// would leave the hospital holding a version the appliance no longer has.
  deliverAfter   DateTime
  transport      EhrImportTransport
  attemptCount   Int               @default(0)
  nextAttemptAt  DateTime?
  leaseOwner     String?
  leaseExpiresAt DateTime?
  sentAt         DateTime?
  errorCode      String?
  supersedesId   String?           @unique
  supersedes     EhrDelivery?      @relation("EhrSupersession", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy   EhrDelivery?      @relation("EhrSupersession")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  /// One message of each kind per finalization: a redelivery attempt must not
  /// become a second message the hospital files twice.
  @@unique([finalizationId, kind])
  @@index([status, deliverAfter])
  @@index([status, nextAttemptAt])
  @@index([caseId, kind])
}

enum PatientIdentifierType {
  /// История на заболяването — the hospital record number a clinician types.
  IZ
  /// ЕГН, the Bulgarian national identifier. Opt-in per site; a site that never
  /// enables it never stores one.
  EGN
}

model PatientLink {
  id                   String                @id @default(cuid())
  institutionId        String
  institution          Institution           @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  /// Which numbering space the identifier belongs to. Without it, one digit
  /// string could be both a record number and a national identifier and the two
  /// patients would collapse into one row.
  identifierType       PatientIdentifierType @default(IZ)
  /// The year the record number belongs to. ИЗ № restarts at 1 every January,
  /// so the number alone is not unique: ИЗ № 42 from last year and ИЗ № 42 from
  /// this year are different admissions and must not become one patient.
  /// 0 means the identifier is not year-scoped — ЕГН is issued once for life.
  identifierYear       Int                   @default(0)
  identifierHash       String
  /// How identifierHash was derived. Version 1 hashed institution and
  /// identifier only; version 2 mixes in the type and, for a year-scoped
  /// identifier, the year — so neither a different numbering space nor a
  /// different year can produce the same digest. Rows written before either
  /// existed keep version 1 and are still found, because rehashing them would
  /// mean decrypting every stored identifier on the appliance, a larger
  /// exposure than the collision it closes.
  hashVersion          Int                   @default(1)
  identifierCiphertext String
  identifierNonce      String
  identifierAuthTag    String
  keyVersion           Int                   @default(1)
  maskedIdentifier     String
  createdById          String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  cases                Case[]

  /// The person this admission belongs to, once a national identifier is known.
  ///
  /// A record number identifies an admission, not a patient: it restarts every
  /// January and a new one is issued each time someone is admitted. So the same
  /// person returning next year is a different link, and without this the two
  /// admissions are two unrelated people in every export. ЕГН is issued once for
  /// life and is what joins them.
  ///
  /// Null whenever the site has not enabled national identifiers, or has not
  /// learned one for this admission yet — which is the normal state, and why
  /// everything downstream falls back to the admission's own identity.
  personLinkId         String?
  personLink           PatientLink?          @relation("AdmissionPerson", fields: [personLinkId], references: [id], onDelete: SetNull)
  admissions           PatientLink[]         @relation("AdmissionPerson")

  @@unique([institutionId, identifierType, identifierYear, identifierHash])
  @@index([personLinkId])
  @@index([institutionId, maskedIdentifier])
}

model CentralExportPolicy {
  id                  String      @id @default(cuid())
  institutionId       String      @unique
  institution         Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  enabled             Boolean     @default(false)
  approvedById        String?
  approvedAt          DateTime?
  // There is deliberately no control over timestamp precision. includeExactTimes
  // was offered here and implemented nowhere; blurring clock times in an
  // anaesthesia register destroys the intervals the register exists to record --
  // two drugs given at 14:05 and 14:50 both become 14:00 and read as
  // simultaneous. If calendar dates ever need protecting, the technique is date
  // shifting agreed with Central, which preserves every interval exactly, not a
  // toggle that coarsens them.
  includeRedactedText Boolean     @default(true)
  redactionProfile    String      @default("bg-en-v1")
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model CaseCentralExportControl {
  caseId      String                @id
  case        Case                  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  decision    CentralExportDecision @default(DEFAULT)
  reasonCode  String?
  reasonNote  String?
  decidedById String
  decidedAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([decision, updatedAt])
}

model HospitalInstallation {
  id                            String    @id @default("local")
  siteId                        String?
  siteCode                      String?
  institutionId                 String?
  centralBaseUrl                String?
  centralEnabled                Boolean   @default(false)
  signingKeyId                  String?
  centralEncryptionKeyId        String?
  centralEncryptionPublicKeyPem String?   @db.Text
  receiptSigningKeyId           String?
  receiptSigningPublicKeyPem    String?   @db.Text
  supportedManifestVersions     Json?
  maximumUploadBytes            Int?
  multipartChunkBytes           Int?
  nextSequence                  Int       @default(1)
  lastAcceptedBatchId           String?
  enrolledAt                    DateTime?
  lastCapabilitiesAt            DateTime?
  lastDeliveryAt                DateTime?
  transportConfigurationHash    String?
  transportConfiguredAt         DateTime?
  transportConfiguredById       String?
  transportConfiguredBy         User?     @relation("HospitalTransportConfigurator", fields: [transportConfiguredById], references: [id], onDelete: Restrict)
  transportConfigurationReason  String?
  /// The one administrator whose password is synchronized with the independent
  /// appliance status service. The relation is restrictive so an operator can
  /// never be hard-deleted underneath the appliance credential workflow.
  applianceOperatorUserId       String?   @unique
  applianceOperator             User?     @relation("ApplianceOperator", fields: [applianceOperatorUserId], references: [id], onDelete: Restrict)
  /// Monotonic generation shared with Status. It makes interrupted rotations
  /// detectable and resumable without ever comparing or transporting hashes.
  operatorCredentialGeneration  Int       @default(0)
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt
}

model ClinicalGuidancePolicy {
  id               String   @id @default("local")
  adultEnabled     Boolean  @default(true)
  pediatricEnabled Boolean  @default(true)
  changedById      String?
  changedBy        User?    @relation("ClinicalGuidancePolicyChanger", fields: [changedById], references: [id], onDelete: Restrict)
  changeReason     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Which keys this database was built under.
///
/// The patient keys are generated once at install and never rotate — there is
/// no rotation path, and generate-secrets.sh refuses to replace an existing
/// .env. They exist only in that file and in whatever the hospital escrowed;
/// backups carry their fingerprints, never the keys, so a lost .env means every
/// stored identifier is undecryptable and every pseudonym already at Central is
/// unmatchable forever.
///
/// Restoring a database without its secrets therefore produces an appliance
/// that looks completely healthy while writing into a parallel identity space.
/// Recording the fingerprints here makes that detectable: the restored database
/// remembers what it was built under, and the mismatch is loud.
///
/// Trust on first use. A row absent means nothing has been recorded yet — a
/// fresh install, or the first start after this shipped — and whatever keys are
/// loaded are by definition the right ones, so they are simply written down. A
/// fresh install can never be blocked by this, because there is nothing for it
/// to disagree with.
model HospitalKeyIdentity {
  id                            String    @id @default("local")
  patientHmacKeyFingerprint     String
  patientEncryptionKeyFingerprint String
  exportPseudonymKeyFingerprint String
  recordedAt                    DateTime  @default(now())
  /// Set only when an operator has deliberately continued under different keys,
  /// accepting that identities written under the old ones are unrecoverable.
  /// A recovery choice, and one that has to carry a name and a reason.
  overriddenAt                  DateTime?
  overriddenById                String?
  overrideReason                String?
  updatedAt                     DateTime  @updatedAt
}

model HospitalExternalAiPolicy {
  id                           String             @id @default("local")
  externalAiEnabled            Boolean            @default(true)
  provider                     ExternalAiProvider @default(MISTRAL)
  credentialCiphertext         String?            @db.Text
  credentialNonce              String?
  credentialAuthTag            String?
  credentialKeyVersion         Int?
  credentialSealKeyFingerprint String?
  credentialConfiguredAt       DateTime?
  credentialChangedAt          DateTime?
  credentialChangedById        String?
  credentialChangedBy          User?              @relation("HospitalExternalAiCredentialChanger", fields: [credentialChangedById], references: [id], onDelete: Restrict)
  policyChangedAt              DateTime?
  policyChangedById            String?
  policyChangedBy              User?              @relation("HospitalExternalAiPolicyChanger", fields: [policyChangedById], references: [id], onDelete: Restrict)
  policyChangeReason           String?
  /// Pinned Mistral model for the advisor; null means the release default
  /// (lib/hospital/external-ai-models.ts). Checked against the list in code,
  /// not by the database, because Mistral retires models between releases.
  advisorModel                 String?
  /// Pinned Mistral model that reads lab report and monitor photos.
  visionModel                  String?
  modelsChangedAt              DateTime?
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt
}

/// Whether this site permits an ЕГН (national identifier) link to be created.
///
/// ЕГН is what joins a patient's separate admissions into one person: ИЗ № is
/// issued per admission and restarts every January, so it cannot do that job
/// alone. Recording ЕГН is nonetheless a heavier privacy commitment than a
/// record number, and the hospital -- not this software's vendor -- is the
/// data controller for it. Enabled by default; a site that will not hold
/// national identifiers turns this off deliberately.
model HospitalPatientIdentifierPolicy {
  id           String    @id @default("local")
  egnPermitted Boolean   @default(true)
  changedAt    DateTime?
  changedById  String?
  changedBy    User?     @relation("HospitalPatientIdentifierPolicyChanger", fields: [changedById], references: [id], onDelete: Restrict)
  changeReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Which transport, if any, this site uses to receive proposed EHR values
/// into EhrImport staging. Absent transport (null) means the adapter is
/// disabled -- a site that has not set one up sends nothing anywhere and
/// stages nothing.
///
/// A watched directory needs no secret: FOLDER is a filesystem path the
/// hospital's own system writes into, read by a process already trusted with
/// the database itself. FHIR and HL7v2 reach outside that boundary to pull
/// or receive from a hospital endpoint, so those two carry a sealed
/// credential the same way the external-AI provider credential does -- an
/// AES-256-GCM tuple whose key lives in a file outside this database, never
/// a plaintext column.
model HospitalEhrTransportPolicy {
  id                            String              @id @default("local")
  transport                     EhrImportTransport?
  /// Where messages go. Deliberately not inside the sealed credential: an
  /// operator has to be able to see where clinical data is being sent without
  /// unsealing anything, and a destination is site configuration rather than a
  /// secret. Null for FOLDER, which has no endpoint.
  endpoint                      String?
  endpointChangedAt             DateTime?
  /// Which of the hospital's identifier systems the record number lives in.
  ///
  /// A hospital numbers the same person several ways -- an admission number, a
  /// permanent record number, a ward number, a visit number -- and they are
  /// separate namespaces that happen to hold numbers of the same shape. A
  /// patient search on value alone can therefore return exactly one match that
  /// belongs to a different numbering, and importing a stranger's allergies is
  /// the worst outcome this system has.
  ///
  /// Null means nobody has said yet, which is not an error: a site must be able
  /// to start before it has answered, so an unverifiable match is warned about
  /// rather than refused until this is set.
  recordNumberSystem            String?
  recordNumberSystemChangedAt   DateTime?
  recordNumberSystemChangedById String?
  /// Which of the hospital's identifier systems its ЕГН values live in.
  ///
  /// Separate from the record number's system because they are different
  /// namespaces: one is this hospital's own admission numbering, the other is
  /// a national register. A site that holds only ИЗ № never sets this.
  ///
  /// Used on the way out. An outgoing record labelled with a system the
  /// receiving hospital does not know is a number they cannot match, so it
  /// files unlinked or is refused.
  nationalIdentifierSystem          String?
  nationalIdentifierSystemChangedAt DateTime?
  nationalIdentifierSystemChangedById String?
  endpointChangedById           String?
  /// How the credential is presented. The sealed credential holds the static
  /// token or the client secret depending on this; everything else about the
  /// exchange is site configuration and stays readable.
  authMode                      EhrAuthMode         @default(STATIC_BEARER)
  /// Where the client credentials are exchanged for a token. Null unless
  /// authMode is OAUTH2_CLIENT_CREDENTIALS.
  tokenUrl                      String?
  /// Not a secret — a client id identifies, it does not authenticate. Kept
  /// readable for the same reason as the endpoint: an operator should be able
  /// to see how this appliance presents itself without unsealing anything.
  clientId                      String?
  scope                         String?
  credentialCiphertext          String?             @db.Text
  credentialNonce               String?
  credentialAuthTag             String?
  credentialKeyVersion          Int?
  credentialSealKeyFingerprint  String?
  credentialConfiguredAt        DateTime?
  credentialChangedAt           DateTime?
  credentialChangedById         String?
  credentialChangedBy           User?               @relation("HospitalEhrTransportCredentialChanger", fields: [credentialChangedById], references: [id], onDelete: Restrict)
  transportChangedAt            DateTime?
  transportChangedById          String?
  transportChangedBy            User?               @relation("HospitalEhrTransportPolicyChanger", fields: [transportChangedById], references: [id], onDelete: Restrict)
  transportChangeReason         String?
  /// How many days staged EHR data is kept before it is deleted
  /// (lib/hospital/ehr-retention.ts). 1 to 14; an import is offered for 14.
  stagingRetentionDays          Int                 @default(14)
  stagingRetentionChangedAt     DateTime?
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt
}

/// What one of this hospital's laboratory codes means.
///
/// Which code a hospital sends for a given test is not discoverable from any
/// specification — it is a property of their laboratory system, and a hospital
/// with five analysers can have five codes for haemoglobin. So the site says,
/// once, and every later result is placed automatically.
///
/// Several of their codes may point at one of our tests; the reverse is not
/// allowed, which is why the unique key is theirs and not ours. A blood-gas
/// haemoglobin and a main-laboratory one are different tests in our library and
/// stay separately mapped.
///
/// Nothing is blocked while a code is unmapped: the result still imports under
/// whatever the hospital called it. Mapping only improves where it lands, which
/// is what makes this a screen an operator can work through at their own pace
/// rather than a prerequisite for going live.
model HospitalEhrLabCodeMap {
  id             String    @id @default(cuid())
  /// The coding system the hospital used, verbatim. Empty for a bare local code
  /// with no system stated, which is common in a folder drop.
  system         String    @default("")
  /// Their code, exactly as it arrives. Never normalised: a code is an opaque
  /// token in their namespace, and trimming or case-folding it is a guess about
  /// a system we do not own.
  code           String
  /// What they call it, kept only so the mapping screen can show an operator
  /// something they recognise. Not part of the identity.
  reportedLabel  String?
  /// One of the tests in our library, by its canonical name. Checked against
  /// the library when written rather than by a foreign key, because the library
  /// is code and not a table.
  test           String
  /// The unit their results arrive in, when they arrive without one.
  ///
  /// A feed that omits units entirely would otherwise have every result
  /// unconvertible and so unticked, which switches the feature off in practice.
  /// Stating it here is the site saying what their machine emits; it is never
  /// used to override a unit the result actually carries.
  assumedUnit    String?
  mappedAt       DateTime  @default(now())
  mappedById     String?
  mappedBy       User?     @relation("HospitalEhrLabCodeMapper", fields: [mappedById], references: [id], onDelete: Restrict)
  /// How often this code has arrived unmapped, so the screen can rank what is
  /// worth an operator's attention. A code seen twelve times this week matters
  /// more than one seen once last month.
  seenCount      Int       @default(0)
  lastSeenAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([system, code])
  @@index([test])
  @@index([lastSeenAt])
}

/// What a hospital's local vital-sign codes mean.
///
/// This is separate from the laboratory map because the destination is a
/// scalar PREOP field, not a laboratory test. Unknown local vital codes remain
/// visible in Status until an operator assigns one of the six safe destinations.
model HospitalEhrVitalCodeMap {
  id             String    @id @default(cuid())
  system         String    @default("")
  code           String
  reportedLabel  String?
  field          String
  mappedAt       DateTime?
  mappedById     String?
  mappedBy       User?     @relation("HospitalEhrVitalCodeMapper", fields: [mappedById], references: [id], onDelete: Restrict)
  seenCount      Int       @default(0)
  lastSeenAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([system, code])
  @@index([field])
  @@index([lastSeenAt])
}

/// What a hospital's coding-system addresses mean.
///
/// NHIS publishes no FHIR address for its lists, so every vendor invents one.
/// An address that names the list ("…/CL013", "urn:x:ksmp") is recognised on
/// its own; any other is recorded here when it arrives, and an operator says
/// once which list it is. The import is never blocked while one is waiting:
/// its codes arrive as the hospital labelled them.
model HospitalEhrCodeSystem {
  id          String               @id @default(cuid())
  /// The address as the hospital sends it, trimmed.
  system      String               @unique
  /// Null while nobody has answered.
  list        HospitalEhrCodeList?
  /// Where it arrived: diagnoses, procedures, routes, labs.
  seenIn      String[]             @default([])
  /// One code and label that came with it, so the operator recognises it.
  sampleCode  String?
  sampleLabel String?
  seenCount   Int                  @default(0)
  lastSeenAt  DateTime?
  answeredAt  DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([lastSeenAt])
}

