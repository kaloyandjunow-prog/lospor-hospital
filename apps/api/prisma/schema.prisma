  PENDING
  GENERATING
  READY
  UPLOADING
  AWAITING_RECEIPT
  ACCEPTED
  REJECTED
  RETRY
  CANCELLED
}

enum CentralExportDecision {
  DEFAULT
  INCLUDE
  EXCLUDE
  WITHDRAW_REQUESTED
  WITHDRAWN
}

enum ExternalAiProvider {
  MISTRAL
}

enum HospitalAccountTokenPurpose {
  ACTIVATION
  RECOVERY
}

/// What a hospital's local medication codes mean.
///
/// The source code and label remain the hospital's. The selected Drug is a
/// non-destructive interpretation used for the import proposal and future
/// accepted rows; nothing here rewrites an existing case or frozen export.
model HospitalEhrMedicationCodeMap {
  id            String    @id @default(cuid())
  system        String    @default("")
  code          String
  reportedLabel String?
  drugId        String?
  drug          Drug?     @relation(fields: [drugId], references: [id], onDelete: Restrict)
  mappedAt      DateTime?
  mappedById    String?
  mappedBy      User?     @relation("HospitalEhrMedicationCodeMapper", fields: [mappedById], references: [id], onDelete: Restrict)
  seenCount     Int       @default(0)
  lastSeenAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([system, code])
  @@index([drugId])
  @@index([lastSeenAt])
}
