model LabResult {
  id String @id @default(cuid())

  // A result belongs to exactly one of the two records that can hold labs, and
  // `section` says which without having to test the two ids. Preop labs are a
  // snapshot taken before the case; intraoperative ones are repeated draws
  // during it, each with its own `takenAt`. Both are the same clinical object
  // -- the same catalogue, units, reference ranges and LOINC mapping -- so
  // they share this table rather than a parallel one that would have to
  // duplicate all of it.
  //
  // preopId was required until intraop labs existed. Each id keeps its own
  // cascade so a deleted record takes its own results with it.
  section   String                  @default("preop") // "preop" | "intraop"
  preopId   String?
  preop     PreoperativeAssessment? @relation(fields: [preopId], references: [id], onDelete: Cascade)
  intraopId String?
  intraop   IntraoperativeRecord?   @relation(fields: [intraopId], references: [id], onDelete: Cascade)

  caseId            String
  test              String
  value             String?
  valueNum          Float? // parsed numeric value in canonical unit
  unit              String?
  unitCanon         String? // canonical unit from LabLoinc
  loincCode         String? // LOINC code for this test
  /// The range this result was read against.
  ///
  /// The laboratory's own where it supplied one, and the bundled catalogue
  /// only as a fallback. The catalogue is a general adult reference; the
  /// supplied one is this laboratory's, for this assay, on this analyser.
  referenceLow      Float?
  referenceHigh     Float?
  /// Explicit critical thresholds, and only ever the laboratory's own.
  ///
  /// Nothing in the bundled catalogue states one, and deriving them from a
  /// reference range is what made a sodium of 130 read as critical. Without
  /// these columns the thresholds a hospital sends arrive in the case and stop
  /// there, so the export could never call anything critical however extreme.
  criticalLow       Float?
  criticalHigh      Float?
  abnormalFlag      String? // "low" | "normal" | "high" | "critical"
  takenAt           DateTime?
  source            String? // "manual" | "ai-scan" | "import"
  sourceVocabulary  String?
  sourceCode        String?
  standardConceptId Int?
  mappingStatus     ConceptMappingStatus   @default(SOURCE_ONLY)
  sourceVersion     String?
  ordinal           Int                    @default(0)
  createdAt         DateTime               @default(now())

  @@index([caseId])
  @@index([preopId])
  @@index([intraopId])
  @@index([test])
  @@index([loincCode])
  @@index([sourceVocabulary, sourceCode])
  @@index([standardConceptId])
}

