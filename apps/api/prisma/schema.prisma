generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id                              String                               @id @default(cuid())
  /// Public deployments use email as the login identity. Hospital appliances
  /// may keep only an optional contact address; it is never a login fallback.
  email                           String?                              @unique
  /// Case-preserving ASCII Hospital login spelling.
  username                        String?
  /// Lowercase appliance-global lookup key for Hospital usernames.
  usernameCanonical               String?                              @unique
  name                            String
  firstName                       String                               @default("")
  lastName                        String                               @default("")
  title                           String                               @default("")
  passwordHash                    String
  role                            UserRole                             @default(MEMBER)
  accountKind                     AccountKind                          @default(CLINICAL)
  institutionId                   String?
  institution                     Institution?                         @relation("UserPrimaryInstitution", fields: [institutionId], references: [id])
  cases                           Case[]                               @relation("CaseAssignee")
  casesCreated                    Case[]                               @relation("CaseCreator")
  roleRequests                    RoleRequest[]
  institutionChangeRequests       InstitutionChangeRequest[]
  transfersSent                   CaseTransfer[]                       @relation("TransfersSent")
  transfersReceived               CaseTransfer[]                       @relation("TransfersReceived")
  emailVerificationTokens         EmailVerificationToken[]
  researchCohorts                 ResearchCohort[]                     @relation("ResearchCohortOwner")
  researchExports                 ResearchExport[]                     @relation("ResearchExportOwner")
  researchAccessGrants            ResearchAccessGrant[]                @relation("ResearchAccessSubject")
  researchGrantsIssued            ResearchAccessGrant[]                @relation("ResearchAccessGrantor")
  researchSelfAuthorizations      ResearchSelfAuthorization[]
  clinicalRuleReviews             ClinicalRuleReview[]                 @relation("ClinicalRuleReviewer")
  clinicalPresetsCreated          ClinicalPreset[]                     @relation("ClinicalPresetCreator")
  clinicalPresetsPublished        ClinicalPreset[]                     @relation("ClinicalPresetPublisher")
  clinicalPublicationsConfirmed   ClinicalRulesetPublicationEvidence[] @relation("ClinicalRulesetPublicationConfirmer")
  clinicalPresetsOwned            ClinicalPreset[]                     @relation("ClinicalPresetUserOwner")
  clinicalPresetSelections        UserClinicalPresetSelection[]
  platformPresetSelections        PlatformClinicalPresetSelection[]
  institutionPresetSelections     InstitutionClinicalPresetSelection[]
  clinicalOverridesToReview       InstitutionClinicalRuleOverride[]    @relation("ClinicalRuleDesignatedReviewer")
  clinicalOverridesApproved       InstitutionClinicalRuleOverride[]    @relation("ClinicalRuleHodApprover")
  clinicalOverridesProposed       InstitutionClinicalRuleOverride[]    @relation("ClinicalRuleProposer")
  passwordResetTokens             PasswordResetToken[]
  authSessions                    AuthSession[]
  mfaLoginChallenges              MfaLoginChallenge[]
  mfaRecoveryCodes                MfaRecoveryCode[]
  legalAcceptances                LegalAcceptance[]
  /// Deployment-neutral account activation. Public email verification sets
  /// this together with emailVerifiedAt; Hospital administration sets only it.
  activatedAt                     DateTime?
  emailVerifiedAt                 DateTime?
  acceptedTermsAt                 DateTime?
  acceptedPrivacyAt               DateTime?
  termsVersion                    String?
  preferences                     Json                                 @default("{\"ui\":{\"locale\":\"bg\"}}")
  lastLoginAt                     DateTime?
  // Token-revocation epoch: any JWT (web session or mobile bearer) whose iat
  // predates this is rejected — set on password reset so old sessions die.
  passwordChangedAt               DateTime?
  /// AES-256-GCM protected TOTP seed. The data-encryption key is deployment
  /// configuration and is never stored in this database.
  mfaTotpSecretCiphertext         String?
  mfaEnabledAt                    DateTime?
  /// Prevents accepting the same RFC 6238 time-step through two concurrent
  /// login challenges.
  mfaLastTotpStep                 Int?
  /// Temporary access stop. Unlike deletion, suspension has no erasure clock
  /// and can be reversed without changing the account's identity.
  suspendedAt                     DateTime?
  /// Set after restoration so an old password can never revive the account.
  /// A successful one-time password recovery clears it.
  recoveryRequiredAt              DateTime?
  deletedAt                       DateTime?
  /// Terminal marker set when the retention job strips direct identifiers.
  /// Accounts with this marker cannot be restored.
  anonymizedAt                    DateTime?
  createdAt                       DateTime                             @default(now())
  /// Set when an administrator approves a pending self-registration or role
  /// request; distinct from activatedAt, which the appliance sets alone.
  approvedAt                      DateTime?
  clinicalGuidancePoliciesChanged ClinicalGuidancePolicy[]             @relation("ClinicalGuidancePolicyChanger")
  ehrTransportCredentialsChanged  HospitalEhrTransportPolicy[]         @relation("HospitalEhrTransportCredentialChanger")
  ehrTransportPoliciesChanged     HospitalEhrTransportPolicy[]         @relation("HospitalEhrTransportPolicyChanger")
  ehrLabCodesMapped               HospitalEhrLabCodeMap[]              @relation("HospitalEhrLabCodeMapper")
  ehrMedicationCodesMapped        HospitalEhrMedicationCodeMap[]        @relation("HospitalEhrMedicationCodeMapper")
  ehrVitalCodesMapped             HospitalEhrVitalCodeMap[]            @relation("HospitalEhrVitalCodeMapper")
  externalAiCredentialsChanged    HospitalExternalAiPolicy[]           @relation("HospitalExternalAiCredentialChanger")
  externalAiPoliciesChanged       HospitalExternalAiPolicy[]           @relation("HospitalExternalAiPolicyChanger")
  hospitalAccountTokens           HospitalAccountAccessToken[]
  hospitalTransportConfigurations HospitalInstallation[]               @relation("HospitalTransportConfigurator")
  hospitalUsernameReservations    HospitalUsernameReservation[]
  operatedHospitalInstallation    HospitalInstallation?                @relation("ApplianceOperator")
  patientIdentifierPoliciesChanged HospitalPatientIdentifierPolicy[]   @relation("HospitalPatientIdentifierPolicyChanger")
  researchOmopApprovalsIssued     ResearchOmopApproval[]               @relation("ResearchOmopApprover")
  researchOmopApprovalsRequested  ResearchOmopApproval[]               @relation("ResearchOmopRequester")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
  @@index([expiresAt])
}

enum AuthSessionClientType {
  WEB
  PWA
  NATIVE
}

/// Server-side inventory for every session issued by 1.2.0 or later.
///
/// JWTs remain the transport credential, while this row makes selective and
/// all-device revocation immediate and gives users a truthful device list.
model AuthSession {
  jti           String                @id
  userId        String
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientType    AuthSessionClientType
  deviceLabel   String
  issuedAt      DateTime              @default(now())
  lastSeenAt    DateTime              @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
}

/// Short-lived, one-use second-factor continuation created only after a
/// correct password. Only its SHA-256 digest is persisted.
model MfaLoginChallenge {
  id                         String                @id @default(cuid())
  tokenHash                  String                @unique
  userId                     String
  user                       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientType                 AuthSessionClientType
  preferredLocale            String
  deviceLabel                String
  enrollmentSecretCiphertext String?
  expiresAt                  DateTime
  usedAt                     DateTime?
  createdAt                  DateTime              @default(now())

  @@index([userId, usedAt, expiresAt])
  @@index([expiresAt])
}

/// Ten high-entropy recovery codes are shown once at MFA enrollment. Only
/// user-bound SHA-256 digests remain; each row can be consumed once.
model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, codeHash])
  @@index([userId, usedAt])
}

enum UserRole {
  MEMBER
  HEAD_OF_DEPT
  ADMIN
  CLINICIAN // legacy
  RESEARCHER // legacy
}

enum AccountKind {
  CLINICAL
  RESEARCH_ONLY
}

/// Non-human identities that can author immutable release material without
/// becoming accounts. They have no password, email, session, role or login
/// relation by construction.
enum TechnicalPrincipalKind {
  RELEASE
}

model TechnicalPrincipal {
  id                       String                               @id
  kind                     TechnicalPrincipalKind
  displayName              String
  releaseVersion           String
  createdAt                DateTime                             @default(now())
  clinicalPresetsCreated   ClinicalPreset[]                     @relation("ClinicalPresetTechnicalCreator")
  clinicalPresetsPublished ClinicalPreset[]                     @relation("ClinicalPresetTechnicalPublisher")
  publicationsConfirmed    ClinicalRulesetPublicationEvidence[] @relation("ClinicalRulesetTechnicalConfirmer")
  platformSelections       PlatformClinicalPresetSelection[]    @relation("PlatformClinicalPresetTechnicalSelector")

  @@unique([kind, releaseVersion])
}

enum LegalDocumentKind {
  TERMS
  PRIVACY
}

enum LegalDocumentLocale {
  BG
  EN
}

/// Exact evidence of the legal text accepted by an account.
///
/// The legacy timestamp/version columns on User remain temporary compatibility
/// shadows. They are not sufficient evidence because they cannot identify the
/// deployment, privacy document, language, effective date, or exact content.
model LegalAcceptance {
  id                  String              @id @default(cuid())
  userId              String
  user                User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  deployment          String
  kind                LegalDocumentKind
  documentVersion     String
  documentEffectiveAt DateTime            @db.Date
  locale              LegalDocumentLocale
  contentSha256       String
  acceptedAt          DateTime            @default(now())

  @@unique([userId, deployment, kind, documentVersion, documentEffectiveAt, locale, contentSha256], map: "LegalAcceptance_exact_acceptance_key")
  @@index([userId, kind, acceptedAt])
}

model Institution {
  id                         String                               @id @default(cuid())
  name                       String
  city                       String
  country                    String                               @default("Bulgaria")
  users                      User[]                               @relation("UserPrimaryInstitution")
  institutionChangeRequests  InstitutionChangeRequest[]           @relation("RequestedInstitution")
  cases                      Case[]
  researchCohorts            ResearchCohort[]
  researchExports            ResearchExport[]
  researchAccessGrants       ResearchAccessGrant[]
  researchSelfAuthorizations ResearchSelfAuthorization[]
  clinicalRuleOverrides      InstitutionClinicalRuleOverride[]
  clinicalPresets            ClinicalPreset[]                     @relation("ClinicalPresetInstitutionOwner")
  clinicalPresetSelections   InstitutionClinicalPresetSelection[]
  centralExportPolicy        CentralExportPolicy?
  patientLinks               PatientLink[]
  ehrImports                 EhrImport[]
  ehrDeliveries              EhrDelivery[]
}

// ─── Case ────────────────────────────────────────────────────────────────────

model Case {
  id                   String       @id @default(cuid())
  /// Stable opaque identifier used by research APIs and artifacts. Operational
  /// identifiers (`id` and `caseCode`) must never cross the research boundary.
  researchId           String       @unique @default(uuid()) @db.Uuid
  caseCode             String?
  notes                String?
  userId               String
  user                 User         @relation("CaseAssignee", fields: [userId], references: [id])
  createdById          String
  createdBy            User         @relation("CaseCreator", fields: [createdById], references: [id])
  institutionId        String?
  institution          Institution? @relation(fields: [institutionId], references: [id])
  patientLinkId        String?
  patientLink          PatientLink? @relation(fields: [patientLinkId], references: [id], onDelete: SetNull)
  status               CaseStatus   @default(DRAFT)
  clinicalMode         ClinicalMode @default(ADULT)
  clinicalRulesVersion String?
  /// Set once, the moment status first transitions to AWAITING_REVIEW (never
  /// touched by a later edit that keeps it there). Anchors the pending-close
  /// countdown so any client, on any device, computes the same remaining time
  /// from this one server timestamp rather than a per-browser local clock.
  awaitingReviewAt     DateTime?
  /// When the automatic-closure sweep may next consider this case, and how
  /// many times it has already tried and been refused.
  ///
  /// The sweep takes the oldest 25 expired cases each run. A case it cannot
  /// close stays AWAITING_REVIEW with the same awaitingReviewAt, so without
  /// these it was selected again on every run for ever -- and twenty-five such
  /// cases at the front of the queue meant the twenty-sixth was never examined
  /// at all, however complete it was. One ward's incomplete paperwork could
  /// silently stop automatic closure for the whole hospital.
  ///
  /// Null means no backoff is in effect: never attempted, or attempted and
  /// closed. Cleared if the case leaves AWAITING_REVIEW and returns.
  closeAttemptCount    Int          @default(0)
  closeNextAttemptAt   DateTime?
  finalizedAt          DateTime?
  clientDraftId        String?
  clinicalRevision     Int          @default(0)
  eventRevision        Int          @default(0)
  relationalRevision   Int          @default(0)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  preop                   PreoperativeAssessment?
  intraop                 IntraoperativeRecord?
  postop                  PostoperativeRecord?
  transfers               CaseTransfer[]
  ehrDeliveries           EhrDelivery[]
  lock                    CaseLock?
  events                  CaseEvent[]
  selections              CaseSelection[]
  complications           CaseComplication[]
  fieldStatuses           ClinicalFieldStatus[]
  fieldChanges            CaseFieldChange[]
  finalizations           CaseFinalization[]
  clinicalCalculations    CaseClinicalCalculation[]
  centralExportControl    CaseCentralExportControl?
  centralDeliveryCases    CentralDeliveryCase[]
  centralExportCheckpoint CentralExportCheckpoint?
  centralExportRejection  CentralExportRejection?

  @@unique([userId, caseCode])
  @@unique([createdById, clientDraftId])
  @@index([status])
  @@index([patientLinkId])
  @@index([userId, createdAt])
  @@index([createdById, createdAt])
}

model CaseLock {
  caseId    String   @id
  userId    String
  deviceId  String
  expiresAt DateTime

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

/// The next case number to issue, per clinician per year.
///
/// Case codes used to be derived from the highest code a clinician currently
/// owned. A handover changes what they own, so that ceiling could move
/// backwards: hand away your highest case and the next case you create takes
/// the number you just handed over -- a number already printed on that chart.
/// The unique constraint is [userId, caseCode] and the handed-over case now
/// belongs to someone else, so nothing prevented it.
///
/// A counter only ever moves forward. Gaps are fine and always were (a deleted
/// draft leaves one); reuse is not, because the number is the only thing tying
/// a paper chart to its record.
model CaseCodeSequence {
  userId String
  year   Int
  /// The next number to hand out. Incremented in the same transaction as the
  /// write that consumes it, so a rolled-back case does not burn a number.
  next   Int    @default(1)

  @@id([userId, year])
}

model CaseTransfer {
  id               String         @id @default(cuid())
  caseId           String
  case             Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fromUserId       String
  fromUser         User           @relation("TransfersSent", fields: [fromUserId], references: [id])
  toUserId         String
  toUser           User           @relation("TransfersReceived", fields: [toUserId], references: [id])
  initiatedBy      String
  status           TransferStatus @default(PENDING)
  createdAt        DateTime       @default(now())
  resolvedAt       DateTime?
  // Case codes are per-user sequences, so a transferred case may have to be
  // renumbered into the recipient's sequence. The code it carried beforehand is
  // kept here — otherwise the paper record and the database disagree with no
  // way to reconcile them.
  previousCaseCode String?
  // One pending handover per case is enforced by a partial unique index created
  // in 20260819120000_member_initiated_handover. Prisma cannot express a
  // `WHERE status = 'PENDING'` index, so it lives in SQL and is deliberately
  // absent here — do not "restore" it as a plain @@unique, which would forbid a
  // case from ever being transferred twice.

  @@index([status])
  @@index([toUserId, status])
  // Who is waiting to hand a case over, for the sender's own "awaiting
  // acceptance" list. Without it that view scans every transfer ever made.
  @@index([fromUserId, status])
}

enum TransferStatus {
  PENDING
  ACCEPTED
  // Refused by the recipient.
  DECLINED
  // Withdrawn by the sender before anyone answered. Distinct from DECLINED
  // because "my colleague refused this case" and "I thought better of it" are
  // different events, and a handover trail that cannot tell them apart cannot
  // answer the question anyone would actually ask of it.
  CANCELLED
}

enum CaseStatus {
  DRAFT
  IN_PROGRESS
  AWAITING_REVIEW
  COMPLETE
}

enum ClinicalMode {
  ADULT
  PEDIATRIC
}

enum PediatricAgeUnit {
  DAYS
  MONTHS
  YEARS
}

enum PediatricPainScale {
  FLACC
  FPS_R
  NRS
}

enum ClinicalRuleReviewStatus {
  PENDING
  APPROVED
  REJECTED
  DEPRECATED
}

enum ClinicalPresetStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum ClinicalPresetScope {
  PLATFORM
  INSTITUTION
  USER
}

// ─── Custom terms (free-text entries added by clinicians) ─────────────────────

model RoleRequest {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      RequestStatus @default(PENDING)
  requestedAt DateTime      @default(now())
  resolvedAt  DateTime?
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Asking to move to another institution.
///
/// Choosing an institution at registration is self-service; moving afterwards
/// is not. Institutional membership is what lets a head of department see a
/// clinician's cases, so joining a department is the act that needs that
/// department's consent -- an administrator, or the head of the institution
/// being joined.
///
/// Kept separate from RoleRequest deliberately: the approver differs. A role
/// request is resolved by any administrator, whereas this one can also be
/// resolved by the head of the *requested* institution, and folding both into
/// one table would make that query ambiguous.
model InstitutionChangeRequest {
  id                     String        @id @default(cuid())
  userId                 String
  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The institution being joined. Restricted so an institution cannot be
  /// deleted while a request to join it is outstanding.
  requestedInstitutionId String
  requestedInstitution   Institution   @relation("RequestedInstitution", fields: [requestedInstitutionId], references: [id], onDelete: Restrict)
  /// Where the clinician was when they asked, so an approver can see the move
  /// being made and the audit trail survives the change.
  previousInstitutionId  String?
  status                 RequestStatus @default(PENDING)
  requestedAt            DateTime      @default(now())
  resolvedAt             DateTime?
  resolvedById           String?

  @@index([status, requestedInstitutionId])
  @@index([userId])
}

// ICD-10 vocabulary (seeded from WHO ICD-10 + official BG MZ labels)
model Icd10Code {
  code     String         @id // e.g. "I21"
  labelEn  String
  labelBg  String?
  synonyms Icd10Synonym[]
}

model Icd10Synonym {
  id        String    @id @default(cuid())
  icd10Code String
  icd10     Icd10Code @relation(fields: [icd10Code], references: [code], onDelete: Cascade)
  synonym   String

  @@index([icd10Code])
}

// LOINC codes for coded entries in the 66-test canonical lab library (not a full LOINC import)
model LabLoinc {
  name          String @id // exact name from lab library
  loincCode     String
  unitCanon     String
  referenceLow  Float?
  referenceHigh Float?
}

// ATC drug classification tree (seeded from Athena CONCEPT.csv, vocab ATC)
model Atc {
  code       String  @id // e.g. "N01AB"
  name       String
  level      Int // 1-5
  parentCode String?

  @@index([parentCode])
  @@index([level])
}

// Drug registry (seeded from drugs.json, searchable by name/INN/ATC)
model Drug {
  id            String          @id @default(cuid())
  name          String
  inn           String?
  atcCode       String?
  form          String?
  strength      String?
  optionLibrary OptionLibrary[]
  ehrMedicationCodeMaps HospitalEhrMedicationCodeMap[]

  @@index([name])
  @@index([inn])
  @@index([atcCode])
}

// Shared selectable option catalog for intraop/preop pill-button pickers
// (position, technique, vascular access, airway management, monitoring,
// premedication/intraop drugs, infusions, inhalational agents, fluids,
// clinical events) — one master library both web and mobile read from,
// instead of each app hardcoding its own copies.
enum LibraryCategory {
  POSITION
  AIRWAY_MANAGEMENT
  VASCULAR_ACCESS
  TECHNIQUE
  MONITORING
  PREMED_DRUG
  INTRAOP_EVENT
  INTRAOP_DRUG
  INTRAOP_INFUSION
  INHALATIONAL_AGENT
  INTRAOP_FLUID

  // Preop/postop categorical pickers
  SEX
  BLOOD_GROUP
  NECK_MOBILITY
  MALLAMPATI
  UPPER_LIP_BITE
  CORMACK_LEHANE
  DISPOSITION
  HANDOVER_ITEM

  // Preop/postop numeric range specs — one row per category, range/step/unit in metadata
  AGE_RANGE
  HEIGHT_RANGE
  WEIGHT_RANGE
  BP_SYSTOLIC_RANGE
  BP_DIASTOLIC_RANGE
  HEART_RATE_RANGE
  SPO2_RANGE
  TEMPERATURE_RANGE
  RESPIRATORY_RATE_RANGE
  MOUTH_OPENING_RANGE
  THYROMENTAL_RANGE
  ALDRETE_SUBSCORE_RANGE
  PAIN_NRS_RANGE
}

model OptionLibrary {
  id          String          @id @default(cuid())
  category    LibraryCategory
  value       String // stable code written into CaseEvent/CaseSelection, e.g. "SUPINE", "PROPOFOL"
  labelEn     String
  labelBg     String?
  group       String? // e.g. premed category "Anxiolytics", drug category "Induction"
  parentId    String? // self-relation for tree categories (TECHNIQUE, VASCULAR_ACCESS)
  parent      OptionLibrary?  @relation("LibraryTree", fields: [parentId], references: [id])
  children    OptionLibrary[] @relation("LibraryTree")
  drugId      String? // optional FK into Drug for ATC/INN
  drug        Drug?           @relation(fields: [drugId], references: [id])
  color       String?
  description String?
  sortOrder   Int             @default(0)
  active      Boolean         @default(true)
  metadata    Json? // category-specific extras: doseHints, allowedUnits, defaultUnit, etc.
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([category, value])
  @@index([category, active, sortOrder])
  @@index([parentId])
}

enum ConceptMappingStatus {
  /// An automatic resolution found a standard concept for this source code.
  MAPPED
  /// A human reviewed this mapping and chose it. Behaves like MAPPED for
  /// export, but stays distinguishable: an automatic match and a curated one
  /// are different levels of evidence, and a study that treats them alike is
  /// trusting a string-similarity score as if a clinician had signed it off.
  MANUALLY_CURATED
  /// A candidate mapping was considered and rejected. Distinct from UNMAPPED,
  /// which means nobody has looked yet -- without the distinction a rejected
  /// candidate is indistinguishable from unfinished work and gets proposed
  /// again on every review pass. The concept id is never applied.
  REJECTED
  /// The source vocabulary and code are preserved, but no standard concept has
  /// been resolved.
  SOURCE_ONLY
  /// No source vocabulary and code either.
  UNMAPPED
}

enum ClinicalFieldPresence {
  PRESENT
  ABSENT
  UNKNOWN
  NOT_APPLICABLE
  NOT_DOCUMENTED
}

model ConceptMap {
  id                 String               @id @default(cuid())
  domain             String
  sourceVocabulary   String
  sourceCode         String
  sourceLabelEn      String?
  sourceLabelBg      String?
  standardVocabulary String?
  standardConceptId  Int?
  /// Every standard concept, when the source code maps to several (an ICD-10
  /// combination code such as E11.2, diabetes with a kidney complication):
  /// standardConceptId is then null and the export writes one row per id.
  /// Empty otherwise.
  standardConceptIds Int[]              @default([])
  standardLabel      String?
  mappingStatus      ConceptMappingStatus @default(SOURCE_ONLY)
  sourceVersion      String?
  mappingMethod      String?
  mappingConfidence  Float?
  reviewed           Boolean              @default(false)
  reviewedBy         String?
  reviewedAt         DateTime?
  mappingNotes       String?
  athenaVersion      String?
  active             Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([domain, sourceVocabulary, sourceCode])
  @@index([sourceVocabulary, sourceCode])
  @@index([standardConceptId])
  @@index([mappingStatus])
  @@index([reviewed])
}

model OmopVocabulary {
  vocabularyId        String   @id
  vocabularyName      String?
  vocabularyReference String?
  vocabularyVersion   String?
  vocabularyConceptId Int?
  importedAt          DateTime @default(now())
}

model OmopDomain {
  domainId        String  @id
  domainName      String?
  domainConceptId Int?
}

model OmopConcept {
  conceptId       Int       @id
  conceptName     String
  domainId        String
  vocabularyId    String
  conceptClassId  String
  standardConcept String?
  conceptCode     String
  validStartDate  DateTime?
  validEndDate    DateTime?
  invalidReason   String?
  importedAt      DateTime  @default(now())

  @@index([vocabularyId, conceptCode])
  @@index([domainId])
  @@index([standardConcept])
  @@index([conceptName])
}

model OmopConceptRelationship {
  id             String    @id @default(cuid())
  conceptId1     Int
  conceptId2     Int
  relationshipId String
  validStartDate DateTime?
  validEndDate   DateTime?
  invalidReason  String?
  importedAt     DateTime  @default(now())

  @@unique([conceptId1, conceptId2, relationshipId])
  @@index([conceptId1, relationshipId])
  @@index([conceptId2, relationshipId])
}

model OmopConceptAncestor {
  id                    String   @id @default(cuid())
  ancestorConceptId     Int
  descendantConceptId   Int
  minLevelsOfSeparation Int?
  maxLevelsOfSeparation Int?
