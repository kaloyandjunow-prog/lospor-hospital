// ─── Intraoperative ──────────────────────────────────────────────────────────

model IntraoperativeRecord {
  id     String @id @default(cuid())
  caseId String @unique
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  monthYear       String?
  durationMinutes Int?

  // Legacy time-only columns. These store a bare local wall clock on a dummy
  // date (2000-01-01T08:00:00Z means "08:00", nothing more) with no record of
  // which timezone it was, so they cannot be placed on a real timeline. Kept
  // read-only for rows written before startedAt/endedAt existed; never written
  // for new records. `startTime` was non-nullable, which forced the code to
  // fake "not started yet" as midnight — a Date is always truthy, so every
  // `if (startTime)` guard was defeated and the UI locked to 00:00.
  startTime DateTime?
  endTime   DateTime?

  // True UTC instants, plus the IANA zone they were entered in (e.g.
  // "Europe/Sofia"). CaseEvent.timestamp is already an instant, so this puts
  // start/end on the same footing as the events they bracket — comparable
  // across sites and against the event stream. Local wall clock stays exactly
  // derivable for display from the instant + zone.
  startedAt DateTime?
  endedAt   DateTime?
  timezone  String?

  positions Json @default("[]")

  techniques        Json           @default("[]")
  airwayDevice      AirwayDevice?
  tubeSize          Float? // legacy: shared by LMA/Oral/Nasal ETT before per-device columns existed; kept for old rows, no longer written
  cuffed            Boolean? // legacy: see tubeSize
  peepCmH2O         Float?
  ippv              Boolean        @default(false)
  jetVentilation    Boolean        @default(false)
  fob               Boolean        @default(false)

  // Why this case has no airway device of its own. Both were checkboxes that
  // lived only in the web form's React state: they relaxed the finalisation
  // gate and were then discarded, so the saved record showed no airway device
  // and no reason, and "arrived intubated from ICU" was indistinguishable from
  // "the airway section was skipped".
  //
  // presentsIntubated: the patient arrived with a tracheal tube already in
  // place, put there by somebody else. The intubation is real and belongs in
  // the record; this team simply did not perform it.
  // airwayNotApplicable: no airway intervention at all -- a regional or
  // sedation case where the patient kept their own airway throughout.
  presentsIntubated    Boolean     @default(false)
  airwayNotApplicable  Boolean     @default(false)

  airwayTools       Json           @default("[]")
  airwayNotes       String?
  cormackLehane     CormackLehane?
  airwayDevices     Json           @default("[]")
  ventilationModes  Json           @default("[]")
  lmaSize           Float?
  oralTubeSize      Float?
  oralCuffed        Boolean?
  nasalTubeSize     Float?
  nasalCuffed       Boolean?
  dltType           String?
  dltSide           String?
  dltSize           Float?
  endobronchialSize Float?

  /// LEGACY, read-only. Superseded by the agent_start events, which carry the
  /// agent with its start, end and concentration and export as drug_exposure.
  /// Kept because the printed summary and the case-detail card still display it
  /// for records written before those events existed; nothing writes it now.
  ///
  /// plexusBlock, cvkSite and arterialLineSite sat here too and were dropped in
  /// 20260904140000: single-value enums superseded by the techniques and
  /// vascularAccesses arrays, which export properly and allow more than one.
  /// Unlike this column they had no reader anywhere -- no control wrote them,
  /// no screen showed them, nothing exported them.
  volatileAgent    VolatileAgent?

  ecg              Boolean @default(false)
  urinaryCatheter  Boolean @default(false)
  stomachTube      Boolean @default(false)
  spO2Monitor      Boolean @default(true)
  invasiveBP       Boolean @default(false)
  cvpMonitor       Boolean @default(false)
  neuroMonitor     Boolean @default(false)
  nbpMonitor       Boolean @default(true)
  etco2Monitor     Boolean @default(false)
  tempMonitor      Boolean @default(false)
  paCatheter       Boolean @default(false)
  tee              Boolean @default(false)
  bis              Boolean @default(false)
  entropyMonitor   Boolean @default(false)
  nirsMonitor      Boolean @default(false)
  evokedPotentials Boolean @default(false)
  tofMonitor       Boolean @default(false)

  vascularAccesses Json @default("[]")

  premedicationEvening String?
  premedicationMorning String?

  drugsAdministered Json @default("[]")

  crystalloidsMl    Int?
  colloidsMl        Int?
  bloodMl           Int?
  bloodProductsNote String?
  urineMl           Int?
  // Clinician-entered, unlike crystalloidsMl/colloidsMl/bloodMl which are
  // derived from fluid events. Nullable with no default: "not recorded" and
  // "0 mL" are different clinical statements and must stay distinguishable.
  bloodLossMl       Int?

  timeSeriesData Json @default("[]")
  keyEvents      Json @default("[]")

  // Laboratory results drawn during the case, in the same shape preop holds
  // them (@lospor/core LabResult), and for the same reason: the JSON on the
  // record is what the clinician edited, and labRows below is the queryable
  // mirror relational-sync derives from it.
  //
  // Unlike preop's single snapshot these are repeated draws, so each entry
  // carries the `takenAt` that says which draw it belongs to. A blood gas at
  // induction and another after transfusion are two draws, not an edit of one.
  labResults Json @default("[]")

  complications String?

  // Normalised mirror of vascularAccesses JSON (queryable; written best-effort)
  vascularAccessRows VascularAccess[]
  premedicationRows  PremedicationAdministration[]
  labRows            LabResult[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  syncRevision Int      @default(0)
}

