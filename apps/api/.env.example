# Local API development only. Appliance production values come from the root
# .env file generated by scripts/generate-secrets.sh.
LOSPOR_DEPLOYMENT_MODE="hospital"
DATABASE_URL="postgresql://lospor:replace@127.0.0.1:5432/lospor"
DIRECT_URL="postgresql://lospor:replace@127.0.0.1:5432/lospor"

LOSPOR_AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_SECRET="replace-with-the-same-long-random-string"
LOSPOR_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
LOSPOR_DATABASE_URL="http://localhost:3003"
CORS_ALLOW_ORIGIN="http://localhost:8081"
CORS_ALLOW_ORIGINS="http://localhost:3000,http://localhost:3003,http://localhost:8081"

HOSPITAL_REQUIRE_PATIENT_NUMBER="true"
HOSPITAL_PATIENT_HMAC_KEY="base64-encoded-32-byte-key"
HOSPITAL_PATIENT_ENCRYPTION_KEY="base64-encoded-32-byte-key"
HOSPITAL_EXPORT_PSEUDONYM_KEY="base64-encoded-32-byte-key"
HOSPITAL_EXPORT_DIR=".data/central-exports"
HOSPITAL_EXPORT_BATCH_CASE_LIMIT="500"
HOSPITAL_EXPORT_RETAIN_ACCEPTED_DAYS="7"
HOSPITAL_SITE_SIGNING_PRIVATE_KEY_FILE="../../secrets/site-signing-private.pem"
HOSPITAL_SITE_SIGNING_PUBLIC_KEY_FILE="../../secrets/site-signing-public.pem"
HOSPITAL_SITE_SIGNING_KEY_ID="hospital-ed25519-1"
HOSPITAL_MTLS_CERT_FILE="../../secrets/site-client-cert.pem"
HOSPITAL_MTLS_KEY_FILE="../../secrets/site-client-key.pem"
HOSPITAL_MTLS_CA_FILE="../../secrets/central-ca.pem"
HOSPITAL_WORKER_TOKEN="replace"

RESEARCH_EXPORT_STORAGE_DRIVER="filesystem"
RESEARCH_EXPORT_STORAGE_DIR=".data/research-exports"
RESEARCH_EXPORT_WORKER_SECRET="replace"
RESEARCH_EXPORT_RETENTION_DAYS="30"
OMOP_PSEUDONYM_SALT="replace"
CRON_SECRET="replace"
OPTION_LIBRARY_SNAPSHOT_SECRET="replace"

BREVO_API_KEY=""
AUTH_EMAIL_FROM="no-reply@lospor.org"
AUTH_EMAIL_FROM_NAME="LOSPOR"

# Optional AI services.
MISTRAL_API_KEY=""
MISTRAL_API_BASE="https://api.mistral.ai/v1"
MISTRAL_MODEL=""
MISTRAL_VISION_MODEL=""
MISTRAL_TIMEOUT_MS="30000"

# Local/test-only flags. Never enable these in production.
# AUTH_EMAIL_TEST_LINKS="true"
# ALLOW_MAINTENANCE_SEED="true"
# SEED_TARGET="development"
# WIPE_DEV_CLINICAL_DATA="true"

# Paediatric mode. Production needs BOTH keys: the clinical manifest
# (PEDIATRIC_PRODUCTION_READY in @lospor/core — signed off 2026-08-04 against
# LOSPOR_PEDIATRICS v2, ruleset 2026.08.04-release.1) and this deployment flag.
#
# Both are satisfied: all 181 PEDIATRIC_DRUG_POLICY rules are reviewStatus
# APPROVED in the live register.
#
# Enabling the mode does not loosen the per-drug decisions that review produced,
# and should not: of the 181, only 2 autofill a dose. 51 stay FORMULARY_REQUIRED,
# 35 EXCLUDED, 18 SCHEMA_BLOCKED, 75 manual-entry-only. Those move per drug
# through the rule workflow, never by this switch.
PEDIATRIC_MODE_ENABLED="true"
