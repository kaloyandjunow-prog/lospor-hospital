# The settings hospital IT owns. On an appliance this file is
# /opt/lospor-hospital/site.env; the guided installer writes it. Everything else
# -- secrets, pseudonym keys, backup identity, versions and tuning -- is
# generated into secrets/appliance.env, and .env is compiled from both. Never
# edit .env or put a secret here: the compiler refuses both.

# First unauthenticated language (bg or en).
LOSPOR_DEFAULT_LOCALE=bg

# The two DNS names. The clinical name serves the web app, the phone app at /app
# and the API; research keeps its own name for its own network boundary.
HOSPITAL_CLINICAL_DOMAIN=lospor.example-hospital.org
HOSPITAL_RESEARCH_DOMAIN=lospor-research.example-hospital.org

# Certificate: operator (hospital authority), acme (public, needs inbound port
# 80), or local (self-signed, test only). The CA path applies to operator mode;
# the e-mail receives public-certificate notices in acme mode.
HOSPITAL_TLS_MODE=operator
HOSPITAL_TLS_VERIFY_CA=/etc/ssl/certs/hospital-ca.crt
ACME_EMAIL=it@example-hospital.org

# Exact networks allowed to reach the Research Browser website and the Status
# page. These are documentation-only networks and match no real hospital.
HOSPITAL_RESEARCH_ALLOWED_CIDRS="192.0.2.0/24 2001:db8:30::/64"
HOSPITAL_STATUS_ALLOWED_CIDRS="198.51.100.0/24 2001:db8:40::/64"
HOSPITAL_NETWORK_ALLOW_ALL_PRIVATE=

HOSPITAL_HTTPS_PORT=443
HOSPITAL_STATUS_PORT=3443

# Sender for account e-mail, and the clinician support contact (an internal
# HTTPS URL or a mailto: address; blank sends clinicians to their local
# administrator).
AUTH_EMAIL_FROM=no-reply@lospor.example-hospital.org
AUTH_EMAIL_FROM_NAME=LOSPOR
HOSPITAL_SUPPORT_URL=

# connected (download from the public GitHub release) or offline (USB), and the
# local window in which updates may be applied.
HOSPITAL_UPDATE_SUPPLY_MODE=connected
HOSPITAL_UPDATE_WINDOW_START=20:00
HOSPITAL_UPDATE_WINDOW_END=06:00
HOSPITAL_UPDATE_TIMEZONE=Europe/Sofia
