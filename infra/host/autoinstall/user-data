#cloud-config
# LOSPOR Hospital host: Ubuntu 24.04 LTS server, ready for the appliance.
#
# Hypervisor-neutral. Hyper-V (infra/host/hyperv/New-LosporHospitalVm.ps1),
# VMware and bare metal all use it the same way: put this file and an empty
# meta-data file on a small FAT volume labelled CIDATA, attach it next to the
# Ubuntu 24.04 server ISO, and boot. The installer asks once, "Continue with
# autoinstall? (yes|no)" -- type yes -- unless `autoinstall` is on the kernel
# command line; the Hyper-V kit writes an ISO copy whose boot menu adds it.
#
# What it sets up: the minimal server, OpenSSH (keys only), Docker Engine and
# Compose from Docker's repository with its signing key pinned by full
# fingerprint, the host commands the appliance needs, automatic security
# updates, time synchronisation (chrony, which on Hyper-V also reads the
# host's clock, so a server with no time server of its own still has the time),
# and a first console login that offers to start
# the LOSPOR installation. When Ubuntu is installed the machine switches off,
# so the installation media can be removed before it starts again.
#
# The console user is `lospor`. There is no shared initial password: the
# Hyper-V kit writes a one-time password for each machine, and anyone using
# this file directly replaces LOSPOR_PASSWORD_HASH below (see
# docs/host-preparation.md). SSH never accepts a password.
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  timezone: Europe/Sofia
  source:
    id: ubuntu-server-minimal
  # Stops before anything is written when the password was never set. A
  # placeholder left in place would install a server nobody can log in to.
  early-commands:
    # The [H] keeps this line from matching itself.
    - "! grep -Eq '^ *password: *\"?LOSPOR_PASSWORD_[H]ASH' /autoinstall.yaml"
  identity:
    hostname: lospor-hospital
    username: lospor
    # A SHA-512 crypt hash ($6$). The Hyper-V kit writes a one-time password's
    # hash here; otherwise use the output of `openssl passwd -6`.
    password: "LOSPOR_PASSWORD_HASH"
  ssh:
    install-server: true
    allow-pw: false
    authorized-keys: []
  # LVM leaves room to grow the data volume. Full-disk encryption is the
  # hospital's decision: the Hyper-V kit replaces this block with a LUKS layout
  # when given -EncryptDisk, and on other hypervisors use host or storage
  # encryption, or set `password:` here (see docs/host-preparation.md).
  storage:
    layout:
      name: lvm
      sizing-policy: all
  apt:
    sources:
      docker.list:
        # Docker's release signing key, carried here rather than fetched from a
        # keyserver: gpg reaches keyservers on its own port and never through a
        # proxy, so a hospital that only goes out through one stopped here
