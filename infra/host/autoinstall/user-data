  packages:
    - docker-ce
    - docker-ce-cli
    - containerd.io
    - docker-compose-plugin
    - openssl
    - curl
    - ca-certificates
    - python3
    - gzip
    - tar
    - whiptail
    - util-linux
    - openssh-client
    - unattended-upgrades
    - chrony
    # Hyper-V's key-value exchange: the host sees the VM's address, and the
    # Windows wizard sees the first installation's progress. It runs only on
    # Hyper-V (the service is conditioned on it) and is inert elsewhere.
    - linux-cloud-tools-generic
    - linux-cloud-tools-common
  updates: security
  late-commands:
    # Docker's key signs Docker's repository and nothing else.
    # On 24.04 the installer writes the source as deb822 docker.sources and
    # drops the [arch=] option, so both are restored here.
    - |
      set -e
      key="$(ls /target/etc/apt/trusted.gpg.d/docker.list.*)"
      ext="${key##*.}"
      install -d -m 0755 /target/etc/apt/keyrings
      mv "$key" "/target/etc/apt/keyrings/docker.$ext"
      sources=/target/etc/apt/sources.list.d/docker.sources
      grep -qx 'URIs: https://download.docker.com/linux/ubuntu' "$sources"
      sed -i '/^Signed-By:/d; /^Architectures:/d; $a\' "$sources"
      printf 'Architectures: amd64\nSigned-By: /etc/apt/keyrings/docker.%s\n' "$ext" >> "$sources"
    # The Windows wizard puts the hospital's proxy here, when there is one.
    # lospor-kit: proxy
    # Time (1.11.1). chrony replaces systemd-timesyncd. Under Hyper-V the host's
    # clock, which the host takes from the hospital's domain, is read through the
    # hypervisor (/dev/ptp_hyperv): no time server is needed, and the readiness
    # check's "clock is synchronized" holds within a minute of the first boot.
    # The network time sources Ubuntu configures stay as they are, so a wrong
    # host clock is outvoted when a time server is reachable. chrony stops at a
    # refclock whose device is missing, so the line is written at every start,
    # and only where the device exists: the same disk may later run elsewhere.
    - |
      set -e
      install -d -m 0755 /target/etc/systemd/system/chrony.service.d
      cat > /target/etc/systemd/system/chrony.service.d/lospor-hyperv-clock.conf <<'EOF'
      [Service]
      ExecStartPre=+/bin/sh -c 'if [ -e /dev/ptp_hyperv ]; then echo "refclock PHC /dev/ptp_hyperv poll 3 dpoll -2 offset 0" > /etc/chrony/conf.d/lospor-hyperv.conf; else rm -f /etc/chrony/conf.d/lospor-hyperv.conf; fi'
      EOF
      chmod 0644 /target/etc/systemd/system/chrony.service.d/lospor-hyperv-clock.conf
    # The one-time password works once, at the console, and must then be
    # changed. The kit removes this line when it is given an SSH key: an expired
    # password would refuse that key until someone had used the console.
    - curtin in-target -- chage -d 0 lospor # lospor-kit: expire
    - curtin in-target -- usermod -aG docker lospor
    - curtin in-target -- systemctl enable docker.service containerd.service chrony.service unattended-upgrades.service
    # Security updates install on their own; the appliance's own updates stay a
    # deliberate action.
    - |
      cat > /target/etc/apt/apt.conf.d/20auto-upgrades <<'EOF'
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
      EOF
    # lospor-kit: bootstrap
    - |
      cat > /target/etc/profile.d/lospor-first-login.sh <<'EOF'
      # Offer the LOSPOR installation on the console until it has been installed.
      #
      # The installer offered here is the copy the Hyper-V kit carried onto this
      # machine, so nothing is downloaded and run before it has verified the
      # release. Without that copy (this seed used by hand) the commands are only
      # shown: the online one fetches the script from lospor.org unverified.
      if [ -t 0 ] && [ "$(id -un)" = lospor ] && [ -f /var/lib/lospor-firstboot-result ] && [ ! -e /opt/lospor-hospital/current ]; then
        # A server made by the Windows wizard installs LOSPOR on its own.
        printf '\nLOSPOR Hospital, first installation: %s\n' "$(sed -n 's/^message=//p' /var/lib/lospor-firstboot-result)"
        printf 'Progress: sudo tail -f /var/log/lospor-firstboot.log\n\n'
      elif [ -t 0 ] && [ "$(id -un)" = lospor ] && [ ! -e /opt/lospor-hospital/current ] && [ -z "${SSH_CONNECTION:-}" ]; then
        lospor_bootstrap=/usr/local/lib/lospor/losporctl-install.sh
        printf '\nThis server is ready for LOSPOR Hospital.\n'
        if [ -f "$lospor_bootstrap" ]; then
          printf 'Online:  sudo sh %s\n' "$lospor_bootstrap"
          printf 'Offline: insert the LOSPOR USB, then: sudo sh /media/usb/losporctl-install.sh\n\n'
          printf 'Start the online installation now? [y/N] '
          read -r lospor_answer
          if [ "$lospor_answer" = y ] || [ "$lospor_answer" = Y ]; then
            sudo sh "$lospor_bootstrap"
          fi
          unset lospor_answer
        else
          printf 'Online:  curl -fsSLO https://lospor.org/install/losporctl-install.sh && sudo sh losporctl-install.sh\n'
          printf 'Offline: insert the LOSPOR USB, then: sudo sh /media/usb/losporctl-install.sh\n\n'
        fi
        unset lospor_bootstrap
      fi
      EOF
    - chmod 0644 /target/etc/profile.d/lospor-first-login.sh
    # The Windows wizard replaces this with the first-boot installation and its
    # answers; otherwise the kit removes it.
    # lospor-kit: firstboot
    # Last, so it is written only when everything before it succeeded: the kit
    # reads this mark from the seed disk once the machine has switched off, and
    # removes the installation media only when it is there.
    - |
      mkdir -p /run/lospor-cidata
      if mount -t vfat /dev/disk/by-label/CIDATA /run/lospor-cidata; then
        date -u +%Y-%m-%dT%H:%M:%SZ > /run/lospor-cidata/lospor-installed
        sync
        umount /run/lospor-cidata
      fi || true
  shutdown: poweroff
