[Unit]
# The host-side update agent.
#
# On the host rather than in a container because applying a release runs
# `docker compose down`: a clock inside a container cannot supervise its own
# restart.
Description=LOSPOR Hospital host maintenance agent
Documentation=file:/opt/lospor-hospital/current/docs/updates-compatibility.md file:/opt/lospor-hospital/current/docs/terminology-import.md
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
# Through `current`, never a versioned directory. The activation moves that
# symlink, the running agent notices and exits 0, and Restart=always brings it
# back from the new path -- which is how a release ships a fix to the agent that
# applied it. Pointing this at a version would pin the agent to whichever
# release happened to install it.
EnvironmentFile=-/etc/lospor-hospital/update-agent.env
ExecStartPre=/usr/bin/test -L /opt/lospor-hospital/current
ExecStart=/bin/sh /opt/lospor-hospital/current/scripts/update-agent-loop.sh
WorkingDirectory=/opt/lospor-hospital/current
Restart=always
RestartSec=10
UMask=0077

# Root, because it applies releases: it runs docker compose and moves the
# release symlink and runs fixed terminology operations. Everything it acts on is written by Status, which is
# unprivileged and cannot do either -- the split is the point of the design.
User=root

# It reads requests, writes its own state, and runs the ordinary update
# scripts. The only other writable places are where Hospital IT mounts an
# off-host backup share, for connection tests and drills requested from Status.
ProtectSystem=strict
ReadWritePaths=/opt/lospor-hospital -/mnt -/media -/srv
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
NoNewPrivileges=yes
LockPersonality=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
