[Unit]
# The host-side update agent.
#
# On the host rather than in a container because applying a release runs
# `docker compose down`: a clock inside a container cannot supervise its own
# restart.
Description=LOSPOR Hospital update agent
Documentation=file:/opt/lospor/current/docs/updates-compatibility.md
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
# Through `current`, never a versioned directory. The activation moves that
# symlink, the running agent notices and exits 0, and Restart=always brings it
# back from the new path -- which is how a release ships a fix to the agent that
# applied it. Pointing this at a version would pin the agent to whichever
# release happened to install it.
ExecStart=/bin/sh /opt/lospor/current/scripts/update-agent-loop.sh
WorkingDirectory=/opt/lospor/current
Restart=always
RestartSec=10

# Root, because it applies releases: it runs docker compose and moves the
# release symlink. Everything it acts on is written by Status, which is
# unprivileged and cannot do either -- the split is the point of the design.
User=root

# It reads requests, writes its own state, and runs the ordinary update
# scripts. Nothing else on the host is its business.
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
NoNewPrivileges=no
LockPersonality=yes

# A crash loop must not become a busy loop against the Docker daemon.
StartLimitIntervalSec=300
StartLimitBurst=10

[Install]
WantedBy=multi-user.target
