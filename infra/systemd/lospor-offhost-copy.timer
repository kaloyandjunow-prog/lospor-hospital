[Unit]
Description=Copy new LOSPOR Hospital backups off-host every 15 minutes
Documentation=file:/opt/lospor-hospital/current/docs/backup-restore.md

[Timer]
OnBootSec=5min
OnUnitActiveSec=15min
RandomizedDelaySec=60s
Persistent=true
Unit=lospor-offhost-copy.service

[Install]
WantedBy=timers.target
