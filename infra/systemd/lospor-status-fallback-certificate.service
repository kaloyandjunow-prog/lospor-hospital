[Unit]
Description=Renew and reload LOSPOR Status fallback certificate
Documentation=file:/opt/lospor-hospital/current/docs/host-observability.md
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/lospor-hospital/current
ExecStartPre=/usr/bin/test -L /opt/lospor-hospital/current
ExecStart=/bin/sh /opt/lospor-hospital/current/scripts/renew-status-fallback-certificate.sh
UMask=0077

ProtectSystem=strict
ReadWritePaths=/opt/lospor-hospital/secrets/status /opt/lospor-hospital/.data/runtime /opt/lospor-hospital/.data/io-mutation.lock
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
NoNewPrivileges=yes
LockPersonality=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
