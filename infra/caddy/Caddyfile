{
  email {$ACME_EMAIL}

  # Empty in production. Set to `local_certs` for a LAN or bench install, where
  # the appliance answers on a name that resolves to a private address.
  #
  # Caddy asks a public authority for a certificate whenever the site name looks
  # public, and that cannot succeed for a box with no inbound route from the
  # internet — which is every hospital appliance and every laptop testing one.
  # `local_certs` makes Caddy issue its own instead. Browsers warn, correctly,
  # and you click through.
  #
  # Addressing the box by bare IP is not an alternative: SNI cannot carry an IP
  # (the RFC forbids it), so with more than one site defined Caddy has no way to
  # know which certificate to present and the handshake fails before any request
  # is made. Use a name.
  {$HOSPITAL_CADDY_GLOBAL_EXTRA}
}

(security_headers) {
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
}

# One clinical address for the whole department. Staff are told a single name;
# a desktop lands on the web app, a phone installs the PWA from /app, and both
# talk to the API on the same origin, which is why the PWA needs no configured
# API base at all.
#
# This used to be three separate hostnames. The API one had no client: web and
# the research browser reach the API over the internal network, and the PWA
# calls its own origin. Three DNS records and three certificates were being
# maintained for one audience.
{$HOSPITAL_CLINICAL_DOMAIN} {
  import security_headers
  encode zstd gzip

  # Appliance operations must remain reachable when the clinical Web or API
  # is unavailable. Status therefore has its own upstream and authentication;
  # the network allowlist is an additional boundary, not a replacement for
  # that login. Keep this before every clinical catch-all.
  @status_allowed {
    path /status /status/*
    remote_ip {$HOSPITAL_STATUS_ALLOWED_CIDRS}
  }
  handle @status_allowed {
    reverse_proxy status:3004
  }
  @status_forbidden path /status /status/*
  handle @status_forbidden {
    respond "Appliance status requires the hospital management network." 403
  }

  # API first: /v1 belongs to the API on every host that serves clients.
  @api path /v1/*
  handle @api {
    request_body {
      max_size 64MB
    }
    reverse_proxy api:3002
  }

  # The API's liveness and readiness probes sit outside /v1. They were reachable
  # on the old API hostname, and scripts/doctor.sh still needs them, so they are
  # routed explicitly rather than falling through to the web app.
  @api_health path /health/live /health/ready
  handle @api_health {
    reverse_proxy api:3002
  }

  # The PWA is an Expo static export built with baseUrl=/app, so its own asset
  # URLs already carry the prefix. handle_path strips it again before nginx,
  # which serves the export from its root — see infra/nginx/pwa.conf.
  handle_path /app/* {
    reverse_proxy pwa:8080
  }
  redir /app /app/

  # Everything else is the web app, including /privacy and /terms, which the
  # PWA links to and which previously needed their own route.
  handle {
    reverse_proxy web:3000
  }
}

# Research stays on its own name and its own network boundary. Even with the
# clinical host reachable from outside the hospital, disclosure-controlled data
# is not.
{$HOSPITAL_RESEARCH_DOMAIN} {
  import security_headers
  encode zstd gzip

  @allowed remote_ip {$HOSPITAL_RESEARCH_ALLOWED_CIDRS}
  handle @allowed {
    reverse_proxy browser:3003
  }

  respond "Research workspace requires the hospital VPN." 403
}
