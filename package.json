{
  "name": "lospor-hospital",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "vendor:upstream": "node scripts/vendor-upstream.mjs",
    "stamp:upstream": "node scripts/stamp-upstream.mjs",
    "verify:upstream": "node scripts/verify-upstream.mjs",
    "verify:contracts": "node scripts/verify-pinned-contract.mjs",
    "verify:hospital-overlays": "node scripts/verify-hospital-overlays.mjs",
    "test:hospital-overlays": "node --test scripts/verify-hospital-overlays.test.mjs",
    "test:vendor-merge": "node --test scripts/vendor-upstream.test.mjs",
    "test:merge-safety": "npm run test:vendor-merge && npm run test:hospital-overlays && npm run verify:hospital-overlays",
    "verify:no-external-telemetry": "node scripts/verify-no-external-telemetry.mjs",
    "verify:safe-runtime-logs": "node scripts/verify-safe-runtime-logs.mjs",
    "verify:distribution-boundaries": "node scripts/verify-distribution-boundaries.mjs",
    "test:distribution-boundaries": "node --test scripts/verify-distribution-boundaries.test.mjs",
    "verify:release-compose": "node scripts/verify-release-compose.mjs",
    "test:release-compose": "node --test scripts/verify-release-compose.test.mjs",
    "verify:release-workflow": "node scripts/verify-release-workflow.mjs",
    "test:release-workflow": "node --test scripts/verify-release-workflow.test.mjs",
    "test:release-artifacts": "node --test scripts/release-artifacts.test.mjs scripts/release-activation.test.mjs scripts/release-image-evidence.test.mjs scripts/verify-vulnerability-policy.test.mjs",
    "test:installer-contracts": "sh scripts/readiness-check.test.sh && sh scripts/install-supply.test.sh && sh infra/postgres/backup-retention.test.sh && sh scripts/installed-release-state.test.sh",
    "test:migrator-image": "sh scripts/test-migrator-image.sh",
    "e2e:clinical-golden": "npm --prefix apps/web run e2e -- --project=authed clinical-golden-flow.authed.spec.ts",
    "e2e:pwa-offline": "npm --prefix apps/pwa run e2e:pwa -- offline-new-case.spec.ts",
    "e2e:browser-authenticated": "npm --prefix apps/browser run e2e -- authenticated.spec.ts --project=desktop",
    "test:status-fixture": "node --test infra/status-fixture/server.test.mjs",
    "test:status-contracts": "npm run test:status-fixture",
    "verify:provenance": "npm run verify:upstream && npm run verify:contracts && npm run verify:hospital-overlays && npm run verify:distribution-boundaries && npm run verify:no-external-telemetry && npm run verify:safe-runtime-logs",
    "audit": "node scripts/audit-packages.mjs",
    "hospital:identity": "node scripts/generate-hospital-identity.mjs secrets/api",
    "typecheck": "npm run prepare:contract && node scripts/run-all.mjs typecheck",
    "test": "npm run prepare:contract && node scripts/run-all.mjs test",
    "lint": "npm run prepare:contract && node scripts/run-all.mjs lint",
    "build": "node scripts/run-all.mjs build",
    "prepare:contract": "npm --prefix vendor/exchange-contract run build"
  },
  "engines": {
    "node": ">=24"
  }
}
