# Two public DNS records directed to this Hospital server.
#
# The clinical name carries everything clinicians use: the web app at /, the
# installable phone app at /app, and the API at /v1. Research keeps a separate
# name because it keeps a separate network boundary.
# Selected by the first bilingual guided-installer screen. It controls only
# the first unauthenticated view; an explicit login choice is stored on the
# account and then wins across applications.
LOSPOR_DEFAULT_LOCALE=bg
ACME_EMAIL=it@example-hospital.org
HOSPITAL_CLINICAL_DOMAIN=lospor.example-hospital.org
HOSPITAL_RESEARCH_DOMAIN=lospor-research.example-hospital.org

# How this appliance gets its certificate. Three modes; pick the one that
# matches what the hospital network actually allows.
#
#   acme      A public authority issues it, and connects in on port 80 to
#             check the name belongs to you. Needs a public DNS record and
#             inbound port 80 from the internet. Nothing to install.
#
#   operator  Hospital IT issues a certificate from its own authority and
#             gives you two files. Needs no internet at all, and every managed
#             device already trusts it, so clinicians see no warning. This is
#             the usual arrangement for an internal hospital system.
#
#   local     Caddy signs with a root it invents. Needs nothing and is trusted
#             by nothing: every device warns unless IT distributes that root.
#             It also issues twelve-hour certificates, so an appliance switched
#             off overnight serves an expired one in the morning. For a bench.
#
# For `operator`, put the files at secrets/tls/fullchain.pem and
# secrets/tls/private.key (mode 600), then set both lines below.
#
#   HOSPITAL_TLS_MODE=operator
#   HOSPITAL_TLS_VERIFY_CA=/etc/ssl/certs/hospital-ca.crt
#
# HOSPITAL_TLS_VERIFY_CA is what the appliance's own health check trusts when
# it tests itself. Without it an update installs, fails its health check
# against an authority it does not know, and rolls back.
HOSPITAL_TLS_MODE=operator
HOSPITAL_TLS_VERIFY_CA=/etc/ssl/certs/hospital-ca.crt

# Generated from HOSPITAL_TLS_MODE. Do not choose this independently: strict
# readiness requires `tls-acme` only for ACME and an empty value otherwise.
# It is what keeps host port 80 unpublished for operator/local TLS.
COMPOSE_PROFILES=

# The research workspace is reachable only from the institution's exact
# Research/VPN networks. These RFC documentation-only ranges deliberately
# match no hospital network, so copying this example fails closed. The guided
# installer has no default and requires IT to enter the real boundary.
HOSPITAL_RESEARCH_ALLOWED_CIDRS="192.0.2.0/24 2001:db8:30::/64"

# The independent appliance status page is deliberately narrower than the
# clinical application. Keep this to hospital management/VPN networks.
HOSPITAL_STATUS_ALLOWED_CIDRS="198.51.100.0/24 2001:db8:40::/64"

# Optional clinician-facing local support destination. Only an HTTPS ticket/help
# URL without embedded credentials or a bare mailto: address is accepted. The
# PWA shows a privacy-safe diagnostic preview before any deliberate export.
HOSPITAL_SUPPORT_URL=

# Emergency compatibility only. The guided installer never enables this. Set
# to `confirmed` solely when the hospital has documented that all three RFC1918
# ranges are intentionally part of one boundary; world-wide ranges still fail.
HOSPITAL_NETWORK_ALLOW_ALL_PRIVATE=

# Host ports, for a server that already has something on the defaults.
#
# Clinicians reach the appliance on HOSPITAL_HTTPS_PORT, so anything other than
# 443 means they type the port into the address bar. Change it only when 443 is
# genuinely taken.
HOSPITAL_HTTPS_PORT=443

# The outage status page, bound to loopback and reached through an SSH tunnel.
# Only the number is configurable: the appliance always binds it to 127.0.0.1,
# because publishing the outage page to a LAN is a security regression. Match
# the local side of your tunnel to whatever you set here.
HOSPITAL_STATUS_PORT=3443

# There is deliberately no configurable number for port 80. It is published by
# the generated `tls-acme` profile only; operator/local TLS does not occupy it.

# Generate unique values with scripts/generate-secrets.sh. Never reuse them.
HOSPITAL_POSTGRES_PASSWORD=replace
LOSPOR_AUTH_SECRET=replace
HOSPITAL_OPERATIONAL_SECRET_GENERATION=1
HOSPITAL_PATIENT_HMAC_KEY=replace
HOSPITAL_PATIENT_ENCRYPTION_KEY=replace
HOSPITAL_EXPORT_PSEUDONYM_KEY=replace
HOSPITAL_WORKER_TOKEN=replace
RESEARCH_EXPORT_WORKER_SECRET=replace
OMOP_PSEUDONYM_SALT=replace
CRON_SECRET=replace
OPTION_LIBRARY_SNAPSHOT_SECRET=replace

# Pediatric charting itself is fixed on by the signed Compose contract. These
# are only fresh-install choices for prospective calculated entry assistance.
# Status may change the stored runtime policy later; updates preserve that
# database policy and never overwrite it from these bootstrap defaults.
HOSPITAL_ADULT_GUIDANCE_DEFAULT=true
HOSPITAL_PEDIATRIC_GUIDANCE_DEFAULT=true
HOSPITAL_EXTERNAL_AI_DEFAULT=true

# Delivery and local retention.
HOSPITAL_EXPORT_BATCH_CASE_LIMIT=500
HOSPITAL_EXPORT_RETAIN_ACCEPTED_DAYS=7
# Four-hour RPO target. Every completed object is retained for 48 hours, then
# one authenticated daily recovery point is retained for 14 days. Pre-update,
# pre-restore, and explicitly immutable points are protected separately.
HOSPITAL_BACKUP_MANIFEST_HMAC_KEY=replace-with-at-least-32-random-characters
HOSPITAL_BACKUP_SITE_ID=lospor.example-hospital.org
HOSPITAL_BACKUP_APPLIANCE_ID=appliance-replace
# These seven are computed, not chosen -- generate-secrets.sh and
# ensure-api-secrets-layout.sh derive and write each fingerprint from its own
# generated key. Left as an obvious non-hex placeholder rather than a
# same-length run of zeros: at least two of them (external AI, MFA) fail
# closed with "refusing to replace an established appliance key" if this
# value happens to satisfy their `sha256:[0-9a-f]{64}` validation, which an
# all-zero run of exactly 64 hex digits does.
HOSPITAL_PATIENT_HMAC_KEY_FINGERPRINT=sha256:generated-on-first-install
HOSPITAL_PATIENT_ENCRYPTION_KEY_FINGERPRINT=sha256:generated-on-first-install
HOSPITAL_EXPORT_PSEUDONYM_KEY_FINGERPRINT=sha256:generated-on-first-install
HOSPITAL_OMOP_PSEUDONYM_SALT_FINGERPRINT=sha256:generated-on-first-install
HOSPITAL_SITE_SIGNING_KEY_FINGERPRINT=sha256:generated-on-first-install
HOSPITAL_EXTERNAL_AI_SEAL_KEY_FINGERPRINT=sha256:generated-on-first-install
HOSPITAL_MFA_ENCRYPTION_KEY_FINGERPRINT=sha256:generated-on-first-install
HOSPITAL_EXCHANGE_CONTRACT_VERSION=2.2.0
HOSPITAL_DATA_DICTIONARY_VERSION=2.2.0
HOSPITAL_BACKUP_TOOL_VERSION=1.2.0
HOSPITAL_BACKUP_INTERVAL_SECONDS=14400
HOSPITAL_BACKUP_RETRY_SECONDS=300
HOSPITAL_BACKUP_KEEP_ALL_SECONDS=172800
HOSPITAL_BACKUP_DAILY_POINTS=14
HOSPITAL_BACKUP_RESERVE_BYTES=5368709120
HOSPITAL_BACKUP_SPACE_MULTIPLIER_PERCENT=150
RESEARCH_EXPORT_RETENTION_DAYS=30
# How often the appliance anonymises accounts deleted more than 30 days ago and
# prunes rate-limit rows. Daily; there is no reason to shorten it, and lengthening
# it delays an erasure obligation.
HOSPITAL_RETENTION_INTERVAL_SECONDS=86400

# Optional transactional email. Local administrators create accounts, so this
# is only needed for password-reset mail.
#
# AUTH_EMAIL_FROM must be an address at a domain this hospital controls and can
# sign for. Sending as the public project domain fails SPF and DKIM and
# misattributes the message; there is deliberately no default.
BREVO_API_KEY=
AUTH_EMAIL_FROM=no-reply@lospor.example-hospital.org
AUTH_EMAIL_FROM_NAME=LOSPOR

# ── Updates ──────────────────────────────────────────────────────────────────
#
# `connected` uses the private immutable GitHub Release plus GHCR route and
# requires the three root-owned files created by provision-update-credentials.sh.
# `offline` accepts only the complete hand-carried release set and deliberately
# requires no GitHub/GHCR credential.
HOSPITAL_UPDATE_SUPPLY_MODE=connected

# The update agent applies what an operator asks for from the status page. It is
# a systemd unit on the host, not a container: applying a release runs
# `docker compose down`, and a clock inside a container cannot supervise its own
# restart. Install it with:
#
#   sudo cp infra/systemd/lospor-update-agent.service /etc/systemd/system/
#   sudo systemctl enable --now lospor-update-agent
#
# Without it the appliance behaves exactly as it always has: updates are applied
# from the server console, and the status page simply says one is available.

# When the agent may restart the clinical services. Outside these hours a
# request is queued rather than refused, and the page names the time it will
# run; an operator can still choose to apply immediately, which is a separate
# and deliberately separate control.
#
# Read only by the agent. Status never sees these values, so the window cannot
# be widened from the web page.
HOSPITAL_UPDATE_WINDOW_START=20:00
HOSPITAL_UPDATE_WINDOW_END=06:00

# How often the agent looks for a request. 15 seconds matches the status page's
# own refresh, so a click is picked up within one page tick.
HOSPITAL_UPDATE_AGENT_POLL_SECONDS=15

# How often it checks whether a newer release has been published. Daily is
# plenty; the check is cheap and the answer rarely changes.
HOSPITAL_UPDATE_CHECK_INTERVAL_SECONDS=86400
